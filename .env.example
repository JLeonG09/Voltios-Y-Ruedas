# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-en-produccion

# JWT (mínimo 256 bits / 32 caracteres para HS256, preferiblemente 64)
# Generar con: openssl rand -base64 64
JWT_SECRET=generar-con-openssl-rand-base64-64

# Expiración JWT en milisegundos (24 horas = 86400000)
JWT_EXPIRATION=86400000

# Configuración de zona horaria
TZ=America/Costa_Rica

# Perfil de Spring Boot (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev

# Origenes CORS permitidos (separados por coma). Usar el subdominio del frontend
# cuando frontend y backend viven en dominios distintos (ej. Render).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ngrok (opcional): token de cuenta para exponer el frontend local con URL publica.
# Obtenerlo en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# URL publica del frontend (usada en correos, p. ej. recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# SMTP (Gmail por defecto). Habilitar y poner una Contraseña de aplicación
# (App Password) de Google: activa 2FA y genera una en
# https://myaccount.google.com/apppasswords — NO uses tu contraseña normal.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu@cuenta.gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion
# Opcional: remitente que aparece en los correos (default: MAIL_USERNAME)
# MAIL_FROM=no-reply@voltiosyruedas.com